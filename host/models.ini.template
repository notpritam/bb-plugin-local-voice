version = 1

[*]
t = __THREADS__
load-on-startup = true

; Speech recognition (Alibaba Qwen3-ASR 1.7B, Q4_K_M requantized from ggml-org Q8_0)
[qwen3-asr]
model = __DIR__/Qwen3-ASR-1.7B-Q4_K_M.gguf
mmproj = __DIR__/mmproj-Qwen3-ASR-1.7B-Q8_0.gguf
; four slots: a recording is cut into ~8 s chunks at pauses and recognised in parallel
np = 4
c = 16384

; Smaller/faster fallback ASR (loads on first use)
[qwen3-asr-0.6b]
model = __DIR__/Qwen3-ASR-0.6B-Q8_0.gguf
mmproj = __DIR__/mmproj-Qwen3-ASR-0.6B-Q8_0.gguf
np = 4
c = 16384
load-on-startup = false

; Dictation polisher, heavy tier: Gemma 4 26B-A4B (MoE, 4B active — same speed as E4B on a CPU,
; far stronger), Google QAT Q4_K_XL, MTP speculative decoding, thinking off. ~16 GB RAM.
[gemma-4-26b]
model = __DIR__/gemma-4-26B-A4B-it-qat-UD-Q4_K_XL.gguf
spec-type = draft-mtp
model-draft = __DIR__/mtp-gemma-4-26B-A4B-it-Q4_0.gguf
c = 4096
np = 2
reasoning-budget = 0
load-on-startup = __HEAVY_ON__

; Dictation polisher, light tier (Google Gemma 4 E4B instruct, Q4_0, MTP speculative decoding, thinking off)
[gemma-4-e4b]
model = __DIR__/gemma-4-E4B-it-Q4_0.gguf
spec-type = draft-mtp
model-draft = __DIR__/mtp-gemma-4-E4B-it-Q4_0.gguf
c = 4096
reasoning-budget = 0
load-on-startup = __LIGHT_ON__

; Faster/smaller polisher alternative (loads on first use)
[gemma-4-e2b]
model = __DIR__/gemma-4-E2B-it-Q8_0.gguf
spec-type = draft-mtp
model-draft = __DIR__/mtp-gemma-4-E2B-it-Q8_0.gguf
c = 4096
reasoning-budget = 0
load-on-startup = false
